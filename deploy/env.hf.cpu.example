# Source this profile before importing BrainAPI, or use the Docker entrypoint defaults.
PUBLIC_BASE_URL=https://leon4gr45-brain.hf.space
DATA_DB=postgresql
VECTOR_DB=postgresql
GRAPH_DB=networkx
PIPELINE_MODE=lightweight
MODELS_MODE=local
EMBEDDINGS_PROVIDER=ollama
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODELS=/opt/ollama-models
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:270m
EMBEDDING_PROFILE=embeddinggemma2-text-v1
EMBEDDING_NATIVE_DIMENSION=768
EMBEDDING_MRL_DIMENSION=512
# Existing per-store variables are the authoritative stored/indexed dimensions.
EMBEDDING_NODES_DIMENSION=512
EMBEDDING_TRIPLETS_DIMENSION=512
EMBEDDING_OBSERVATIONS_DIMENSION=512
EMBEDDING_DATA_DIMENSION=512
EMBEDDING_RELATIONSHIPS_DIMENSION=512
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_THREADS=2
OLLAMA_EMBEDDING_KEEP_ALIVE=10m
SEARCH_ENABLED=true
SEARCH_USE_DENSE=true
SEARCH_USE_BM25=true
SEARCH_FUSION=rrf
CONTEXT_PASSAGE_MODE=hybrid
DEFAULT_BRAIN_FALLBACK=false
# Set SYSTEM_PAT securely. Do not configure a different BRAINPAT_TOKEN. Chat generation and reranking require separate opt-in setup.

TRACE_MODE=log
# With no durable /data mount, staging requires this explicit override.
# Health remains degraded; production release remains NO-GO.
ALLOW_EPHEMERAL_STORAGE=false

# Logical Brain-content checkpoints; configure GITHUB_PAT only as a Space Secret.
BRAIN_BACKUP_ENABLED=true
BRAIN_BACKUP_REPOSITORY=JsonLord/nodepad-brain-backup
BRAIN_BACKUP_BRANCH=main
BRAIN_BACKUP_INTERVAL_SECONDS=300
# Pin BUILD_SHA to the deployed Git commit for backup source provenance.
